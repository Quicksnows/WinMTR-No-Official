    COMBOBOX        IDC_COMBO_HOST,50,12,140,73,CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
END

IDD_DIALOG_OPTIONS DIALOGEX 0, 0, 251, 164
