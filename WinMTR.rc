    LTEXT           "选项:",IDC_STATIC,7,39,28,8
    LTEXT           "     --interval, -i  设置ping间隔。",IDC_STATIC,26,47,131,8
    LTEXT           "     --size, -s  设置数据包大小。",IDC_STATIC,26,57,109,8
